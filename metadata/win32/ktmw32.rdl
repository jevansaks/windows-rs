#[win32]
mod Windows {
    mod Win32 {
        #[library("ktmw32.dll", set_last_error)]
        extern fn CommitComplete(EnlistmentHandle: HANDLE, TmVirtualClock: *const i64) -> BOOL;
        #[library("ktmw32.dll", set_last_error)]
        extern fn CommitEnlistment(EnlistmentHandle: HANDLE, TmVirtualClock: *const i64) -> BOOL;
