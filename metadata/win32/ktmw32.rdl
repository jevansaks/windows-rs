        #[library("ktmw32.dll", set_last_error)]
        extern fn SetTransactionInformation(TransactionHandle: HANDLE, #[opt] IsolationLevel: u32, #[opt] IsolationFlags: u32, #[opt] Timeout: u32, #[opt] Description: PCWSTR) -> BOOL;
