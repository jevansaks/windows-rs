        #[library("ktmw32.dll", set_last_error)]
        extern fn RecoverResourceManager(ResourceManagerHandle: HANDLE) -> BOOL;
        #[library("ktmw32.dll", set_last_error)]
        extern fn RecoverTransactionManager(TransactionManagerHandle: HANDLE) -> BOOL;
        #[library("ktmw32.dll", set_last_error)]
        extern fn RenameTransactionManager(LogFileName: PCWSTR, ExistingTransactionManagerGuid: *const GUID) -> BOOL;
        #[library("ktmw32.dll", set_last_error)]
        extern fn RollbackComplete(EnlistmentHandle: HANDLE, TmVirtualClock: *const i64) -> BOOL;
        #[library("ktmw32.dll", set_last_error)]
