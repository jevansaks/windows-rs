        #[library("ktmw32.dll", set_last_error)]
        extern fn RollbackTransactionAsync(TransactionHandle: HANDLE) -> BOOL;
        #[library("ktmw32.dll", set_last_error)]
        extern fn RollforwardTransactionManager(TransactionManagerHandle: HANDLE, TmVirtualClock: *const i64) -> BOOL;
        #[library("ktmw32.dll", set_last_error)]
        extern fn SetEnlistmentRecoveryInformation(EnlistmentHandle: HANDLE, BufferSize: u32, Buffer: *const void) -> BOOL;
        #[library("ktmw32.dll", set_last_error)]
