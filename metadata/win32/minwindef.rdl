#[win32]
mod Windows {
    mod Win32 {
        type ATOM = u16;
        type BOOL = i32;
        const FALSE: i32 = 0;
        extern fn FARPROC() -> isize;
        struct FILETIME {
            dwLowDateTime: u32,
            dwHighDateTime: u32,
        }
        type GLOBALHANDLE = HANDLE;
        type HFILE = i32;
        #[invalid_handle(-1)]
        #[invalid_handle(0)]
        #[raii_free("GlobalFree")]
        type HGLOBAL = HANDLE;
        #[also_usable_for("HMODULE")]
        #[invalid_handle(0)]
        #[raii_free("FreeLibrary")]
        type HINSTANCE = *mut void;
        #[invalid_handle(-1)]
        #[invalid_handle(0)]
        #[raii_free("RegCloseKey")]
        type HKEY = *mut void;
        #[invalid_handle(-1)]
        #[invalid_handle(0)]
        #[raii_free("UnloadKeyboardLayout")]
        type HKL = *mut void;
        #[invalid_handle(-1)]
        #[invalid_handle(0)]
        #[raii_free("LocalFree")]
        type HLOCAL = HANDLE;
        type HLSURF = *mut void;
        #[invalid_handle(-1)]
        #[invalid_handle(0)]
        #[raii_free("DeleteMetaFile")]
        type HMETAFILE = *mut void;
        #[also_usable_for("HINSTANCE")]
        #[invalid_handle(0)]
        #[raii_free("FreeLibrary")]
        type HMODULE = HINSTANCE;
        #[also_usable_for("HGDIOBJ")]
        #[invalid_handle(-1)]
        #[invalid_handle(0)]
        #[raii_free("DeleteObject")]
        type HRGN = *mut void;
        #[invalid_handle(-1)]
        #[invalid_handle(0)]
        type HRSRC = *mut void;
        type HSPRITE = *mut void;
        type HSTR = *mut void;
        #[invalid_handle(-1)]
        #[invalid_handle(0)]
        type HTASK = *mut void;
        #[invalid_handle(-1)]
        #[invalid_handle(0)]
        #[raii_free("CloseWindowStation")]
        type HWINSTA = *mut void;
        type LOCALHANDLE = HANDLE;
        type LPARAM = isize;
        type LPBOOL = *mut BOOL;
        type LPBYTE = *mut u8;
        type LPDWORD = *mut u32;
        type LPFILETIME = *mut FILETIME;
        type LPHANDLE = *mut HANDLE;
        type LPINT = *mut i32;
        type LPLONG = *mut i32;
        type LPWORD = *mut u16;
        type LRESULT = isize;
        const MAX_PATH: i32 = 260;
        extern fn NEARPROC() -> isize;
        type PBOOL = *mut BOOL;
        type PBYTE = *mut u8;
        type PDWORD = *mut u32;
        type PFILETIME = *mut FILETIME;
        type PFLOAT = *mut f32;
        type PHKEY = *mut HKEY;
        type PINT = *mut i32;
        extern fn PROC() -> isize;
        type PSZ = *mut i8;
        type PUCHAR = *mut u8;
        type PUINT = *mut u32;
        type PULONG = *mut u32;
        type PUSHORT = *mut u16;
        type PWORD = *mut u16;
        type SPHANDLE = *mut HANDLE;
        const STRICT: i32 = 1;
        const TRUE: i32 = 1;
        type WPARAM = usize;
    }
}
