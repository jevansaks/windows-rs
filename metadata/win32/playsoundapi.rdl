#[win32]
mod Windows {
    mod Win32 {
        #[library("WINMM.dll")]
        extern fn PlaySoundA(#[opt] pszSound: PCSTR, #[opt] hmod: HMODULE, fdwSound: SND_FLAGS) -> BOOL;
        #[library("WINMM.dll")]
        extern fn PlaySoundW(#[opt] pszSound: PCWSTR, #[opt] hmod: HMODULE, fdwSound: SND_FLAGS) -> BOOL;
        const SND_ALIAS_ID: i32 = 1114112;
        const SND_ALIAS_START: i32 = 0;
        const SND_ALIAS_SYSTEMASTERISK: u32 = 10835;
        const SND_ALIAS_SYSTEMDEFAULT: u32 = 17491;
        const SND_ALIAS_SYSTEMEXCLAMATION: u32 = 8531;
        const SND_ALIAS_SYSTEMEXIT: u32 = 17747;
        const SND_ALIAS_SYSTEMHAND: u32 = 18515;
        const SND_ALIAS_SYSTEMQUESTION: u32 = 16211;
        const SND_ALIAS_SYSTEMSTART: u32 = 21331;
        const SND_ALIAS_SYSTEMWELCOME: u32 = 22355;
        #[repr(u32)]
        #[flags]
        #[associated_constant("SND_ALIAS_ID")]
        #[associated_constant("SND_RESOURCE")]
        #[scoped]
        enum SND_FLAGS {
            SND_SYNC = 0,
            SND_ASYNC = 1,
            SND_NODEFAULT = 2,
            SND_MEMORY = 4,
            SND_LOOP = 8,
            SND_NOSTOP = 16,
            SND_NOWAIT = 8192,
            SND_ALIAS = 65536,
            SND_FILENAME = 131072,
            SND_PURGE = 64,
            SND_APPLICATION = 128,
            SND_SENTRY = 524288,
            SND_SYSTEM = 2097152,
        }
        const SND_RESOURCE: i32 = 262148;
        const SND_RING: i32 = 1048576;
        #[library("WINMM.dll")]
        extern fn sndPlaySoundA(#[opt] pszSound: PCSTR, fuSound: u32) -> BOOL;
        #[library("WINMM.dll")]
        extern fn sndPlaySoundW(#[opt] pszSound: PCWSTR, fuSound: u32) -> BOOL;
    }
}
