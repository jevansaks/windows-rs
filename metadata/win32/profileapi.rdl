#[win32]
mod Windows {
    mod Win32 {
        #[library("KERNEL32.dll", set_last_error)]
        extern fn QueryPerformanceCounter(lpPerformanceCount: *mut i64) -> BOOL;
        #[library("KERNEL32.dll", set_last_error)]
        extern fn QueryPerformanceFrequency(lpFrequency: *mut i64) -> BOOL;
    }
}
