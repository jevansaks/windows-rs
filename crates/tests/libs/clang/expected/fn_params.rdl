#[win32]
mod Test {
    #[library("kernel32.dll")]
    extern "C" fn CloseFile(file: HANDLE) -> Windows::Win32::Foundation::BOOL;
    type DWORD = u32;
    type HANDLE = *mut void;
    type LPCSTR = *const i8;
    #[library("kernel32.dll")]
    extern "C" fn OpenFile(name: *const u8, flags: u32) -> HANDLE;
    #[library("kernel32.dll")]
    extern "C" fn ReadFile(file: HANDLE, buffer: *mut void, size: u32, bytesRead: *mut u32) -> Windows::Win32::Foundation::BOOL;
    #[library("kernel32.dll")]
    extern "C" fn WriteFile(file: HANDLE, buffer: *const void, size: u32, bytesWritten: *mut u32) -> Windows::Win32::Foundation::BOOL;
}
