#[win32]
mod Test {
    #[associated_enum("NativeFlags")]
    const ANNOTATED: u32 = 2147483648;
    const BOOL_FALSE: u32 = 0;
    const BOOL_TRUE: u32 = 1;
    const BYTE_VALUE: u8 = 255;
    const CONSTEXPR_VALUE: u32 = 3145747;
